#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int main() {
    char *s = malloc(1024 * sizeof(char));
    if (s == NULL) 
    {
        return 1;
    }
    if (scanf("%s", s) != 1) 
    {
        free(s);
        return 1;
    }
    int frequency[10] = {0};
    for (int i = 0; s[i] != '\0'; i++)
    {
        if (s[i] >= '0' && s[i] <= '9') 
        {
            frequency[s[i] - '0']++;
        }
    }
    for (int i = 0; i < 10; i++) {
        printf("%d", frequency[i]);
        if (i < 9) {
            printf(" ");
        }
    }
    printf("\n");
    free(s);
    return 0;
}
