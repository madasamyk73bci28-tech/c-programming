#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include<assert.h>
#define MAX_CHARACTERS 1005
#define MAX_PARAGRAPHS 5

char* kth_word_in_mth_sentence_of_nth_paragraph(char**** document, int k, int m, int n) {
    return document[n - 1][m - 1][k - 1];
}

char** kth_sentence_in_mth_paragraph(char**** document, int k, int m) {
    return document[m - 1][k - 1];
}

char*** kth_paragraph(char**** document, int k) {
    return document[k - 1];
}

// Fixed get_document with correct 4D pointer reallocation
char**** get_document(char* text) {
    char**** doc = (char****)malloc(sizeof(char***));
    int p_idx = 0, s_idx = 0, w_idx = 0;
    
    // Initial allocation
    doc[0] = (char***)malloc(sizeof(char**));
    doc[0][0] = (char**)malloc(sizeof(char*));
    
    char word[MAX_CHARACTERS];
    int char_idx = 0;
    
    for (int i = 0; ; i++) {
        char ch = text[i];
        
        if (ch == ' ' || ch == '.' || ch == '\n' || ch == '\0') {
            if (char_idx > 0) {
                word[char_idx] = '\0';
                // Allocate and store word
                doc[p_idx][s_idx] = realloc(doc[p_idx][s_idx], (w_idx + 1) * sizeof(char*));
                doc[p_idx][s_idx][w_idx] = malloc((char_idx + 1) * sizeof(char));
                strcpy(doc[p_idx][s_idx][w_idx], word);
                w_idx++;
                char_idx = 0;
            }
            
            if (ch == '.') {
                // End sentence: expand sentence pointer
                s_idx++;
                w_idx = 0;
                doc[p_idx] = realloc(doc[p_idx], (s_idx + 1) * sizeof(char**));
                doc[p_idx][s_idx] = NULL; // New sentence NULL for realloc
            } 
            else if (ch == '\n') {
                // End paragraph: expand paragraph pointer
                p_idx++;
                s_idx = 0;
                w_idx = 0;
                doc = realloc(doc, (p_idx + 1) * sizeof(char***));
                doc[p_idx] = (char**)malloc(sizeof(char**));
                doc[p_idx][0] = NULL;
            }
            
            if (ch == '\0') break;
        } else {
            word[char_idx++] = ch;
        }
    }
    return doc;
}



