include <stdio.h>
#include <stdlib.h>
int* getConcatenation(int* nums, int numsSize, int* returnSize) 
{
    int n = numsSize;
    *returnSize = 2 * n;
    int* ans = (int*)malloc((*returnSize) * sizeof(int));
    for (int i = 0; i < n; i++) 
    {
        ans[i] = nums[i]; 
        ans[i + n] = nums[i]; 
    }
    return ans;
}
