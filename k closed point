#include <stdio.h>
#include <stdlib.h>
typedef struct 
{
    int x;
    int y;
    int distSq;
} PointDist;
int compare(const void* a, const void* b) {
    PointDist* p1 = (PointDist*)a;
    PointDist* p2 = (PointDist*)b;
    return p1->distSq - p2->distSq;
}
int** kClosest(int** points, int pointsSize, int* pointsColSize, int k, int* returnSize, int** returnColumnSizes) 
{
   
    PointDist* list = (PointDist*)malloc(pointsSize * sizeof(PointDist));
    for (int i = 0; i < pointsSize; i++) {
        list[i].x = points[i][0];
        list[i].y = points[i][1];       
        list[i].distSq = (points[i][0] * points[i][0]) + (points[i][1] * points[i][1]);
    }
    qsort(list, pointsSize, sizeof(PointDist), compare);
    *returnSize = k;
    int** result = (int**)malloc(k * sizeof(int*));
    *returnColumnSizes = (int*)malloc(k * sizeof(int));
    for (int i = 0; i < k; i++) 
    {
        result[i] = (int*)malloc(2 * sizeof(int));
        result[i][0] = list[i].x;
        result[i][1] = list[i].y;
        (*returnColumnSizes)[i] = 2; 
    }
    free(list);
    return result;
}
