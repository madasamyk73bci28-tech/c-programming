#include <stdio.h>
#define MAX(a, b) ((a) > (b) ? (a) : (b))
int maxPoints(int** points, int pointsSize, int* pointsColSize) 
{
    if (pointsSize <= 2) 
    {
        return pointsSize;
    }
    
    int maxOverall = 2;
    for (int i = 0; i < pointsSize; i++) 
    {
        int x1 = points[i][0];
        int y1 = points[i][1];
        for (int j = i + 1; j < pointsSize; j++) 
        {
            int x2 = points[j][0];
            int y2 = points[j][1];
            long long dy1 = y2 - y1;
            long long dx1 = x2 - x1;
            int currentLineCount = 2;
            for (int k = j + 1; k < pointsSize; k++) {
                long long dy2 = points[k][1] - y1;
                long long dx2 = points[k][0] - x1;
                if (dy1 * dx2 == dy2 * dx1) {
                    currentLineCount++;
                }
            }
            
            maxOverall = MAX(maxOverall, currentLineCount);
        }
    }
    return maxOverall;
}
