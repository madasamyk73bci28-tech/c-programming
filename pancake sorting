#include <stdio.h>
#include <stdlib.h>
void reverse(int* arr, int k) 
{
    int start = 0;
    int end = k - 1;
    while (start < end) 
    {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
}
int* pancakeSort(int* arr, int arrSize, int* returnSize) 
{
    int* res = (int*)malloc(2 * arrSize * sizeof(int));
    int resIndex = 0;
    for (int target = arrSize; target > 1; target--) 
    {
        int idx = 0;
        for (int i = 0; i < arrSize; i++) 
        {
            if (arr[i] == target) 
            {
                idx = i;
                break;
            }
        }
        if (idx == target - 1) 
        {
            continue;
        }
        if (idx != 0) 
        {
            res[resIndex++] = idx + 1;
            reverse(arr, idx + 1);
        }
        res[resIndex++] = target;
        reverse(arr, target);
    }

    *returnSize = resIndex;
    return res;
}
